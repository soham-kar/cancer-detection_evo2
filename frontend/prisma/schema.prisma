// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  credits          Int       @default(5)
  stripeCustomerId String?   @unique
  freeRunsToday    Int       @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments         Payment[]
  analysisReports  AnalysisReport[]
  chatSessions     ChatSession[]

  @@map("users")
}

model Payment {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  creditsGranted Int
  clerkUserId    String
  createdAt      DateTime @default(now())

  user User @relation(fields: [clerkUserId], references: [clerkId])

  @@map("payments")
}

model AnalysisReport {
  id                       String   @id @default(cuid())
  clerkUserId              String
  geneSymbol               String
  chromosome               String
  position                 Int
  reference                String
  alternative              String
  genomeId                 String
  prediction               String
  deltaScore               Float
  classificationConfidence Float
  classificationSource     String?
  // ClinVar data for comparison
  clinvarClassification    String?
  variationType            String?
  clinvarId                String?
  // Enrichment data as native PostgreSQL JSON
  populationFrequency      Json?
  acmgEvidence             Json?
  literatureContext        Json?
  // Multi-modal RAG output
  clinicalSummary          String?
  evidenceConfidence       Json?
  // In-Silico Mutagenesis scan data
  ismScanData              Json?
  // XAI confidence factors (backend-computed)
  xaiFactors               Json?
  // Counterfactual analysis
  counterfactuals        Json?
  // ACMG/AMP criteria mapping
  acmgCriteria             Json?
  // Knowledge graph (gene-disease-drug)
  knowledgeGraph           Json?
  // External scores (CADD, REVEL)
  externalScores           Json?
  // LLM-refined ACMG criteria
  acmgCriteriaRefined      Json?
  // Analysis source: 'clinvar' or 'custom'
  analysisSource           String?
  // VEP annotation: consequence, aaChange, codons, etc.
  vepAnnotation            Json?
  createdAt                DateTime @default(now())

  user User @relation(fields: [clerkUserId], references: [clerkId])

  chatSessions ChatSession[]

  @@index([clerkUserId])
  @@index([geneSymbol])
  @@map("analysis_reports")
}

model ChatSession {
  id              String   @id @default(cuid())
  clerkUserId     String
  analysisReportId String?
  title           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User           @relation(fields: [clerkUserId], references: [clerkId])
  analysisReport AnalysisReport? @relation(fields: [analysisReportId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([clerkUserId])
  @@index([analysisReportId])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          String   // 'user' | 'assistant' | 'system'
  content       String   @db.Text
  toolCalls     Json?    // structured tool calls from assistant
  toolResults   Json?    // structured tool results
  metadata      Json?    // latency, model, tokens, etc.
  createdAt     DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}
